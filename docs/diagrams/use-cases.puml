@startuml use-cases
' Use case diagram for Expense Tracker 1.2 (CN7021 Week 4: UML use case diagrams)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Helvetica
skinparam usecase {
  BackgroundColor #F3F5F2
  BorderColor #1F6B55
  ArrowColor #61716C
}
skinparam actor {
  BorderColor #1F6B55
}

actor "User" as user
actor "Claude API\n(optional)" as claude <<external system>>

rectangle "Expense Tracker" {
  usecase "Record expense" as UC1
  usecase "Edit expense" as UC2
  usecase "Delete expense" as UC3
  usecase "Suggest category\nfrom description" as UC4
  usecase "Check budget\nand warn" as UC5
  usecase "Browse month" as UC6
  usecase "Search and filter\nexpenses" as UC7
  usecase "View monthly summary\nand chart" as UC8
  usecase "Set monthly budget" as UC9
  usecase "Manage categories" as UC10
  usecase "Choose currency" as UC11
  usecase "Export to CSV" as UC12
}

user --> UC1
user --> UC2
user --> UC3
user --> UC6
user --> UC7
user --> UC9
user --> UC10
user --> UC11
user --> UC12

UC1 ..> UC5 : <<include>>
UC2 ..> UC5 : <<include>>
UC4 .> UC1 : <<extend>>\nwhen typing a description
UC6 ..> UC8 : <<include>>
UC4 --> claude : if API key set,\nelse offline keywords

@enduml
