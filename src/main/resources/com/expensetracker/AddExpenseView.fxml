<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<GridPane hgap="12" vgap="12" styleClass="expense-form" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.expensetracker.AddExpenseController">
    <columnConstraints>
        <ColumnConstraints minWidth="90" />
        <ColumnConstraints minWidth="280" />
    </columnConstraints>

    <Label fx:id="formTitle" styleClass="form-title" text="Add expense" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0" />

    <Label text="Description" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <TextField fx:id="descriptionField" promptText="e.g. Uber to town" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <Label text="Category" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <ComboBox fx:id="categoryComboBox" maxWidth="Infinity" promptText="Choose a category" GridPane.columnIndex="1" GridPane.rowIndex="2" />

    <Label fx:id="suggestionLabel" styleClass="suggestion" visible="false" managed="false" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <Label text="Amount" GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <TextField fx:id="amountField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="4" />

    <Label text="Date" GridPane.columnIndex="0" GridPane.rowIndex="5" />
    <DatePicker fx:id="datePicker" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5" />

    <HBox spacing="8" alignment="CENTER_RIGHT" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="6">
        <Button fx:id="cancelButton" cancelButton="true" onAction="#handleCancel" text="Cancel" />
        <Button fx:id="saveButton" defaultButton="true" onAction="#handleSave" styleClass="primary" text="Save expense" />
    </HBox>
</GridPane>
