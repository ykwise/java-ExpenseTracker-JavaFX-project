<?xml version="1.0" encoding="UTF-8"?>

<?import com.expensetracker.BudgetPanel?>
<?import com.expensetracker.SummaryStrip?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Layout:
  ┌──────────────────────────────────────────────────────────────────────┐
  │ ‹ ›  November 2026  Back to this month   Set budget  Categories  Settings │
  │ [ Spent in November │ Compared with October │ Budgets ]               │
  │ ┌ Expenses ───────────────────────────┐ ┌ Spending by category ────┐ │
  │ │ + Add expense  Edit Delete  Export  │ │  (pie)                    │ │
  │ │ [search.....................] [cat] │ ├ Budgets ─────────────────┤ │
  │ │ table                               │ │  Food ███████░░ 850 of 1k │ │
  │ │ 12 expenses · KES 4,250.00          │ │                           │ │
  │ └─────────────────────────────────────┘ └───────────────────────────┘ │
  └──────────────────────────────────────────────────────────────────────┘
-->
<BorderPane prefHeight="760.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.expensetracker.MainViewController">
   <top>
      <VBox spacing="12.0">
         <padding>
            <Insets bottom="12.0" left="24.0" right="24.0" top="18.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Button onAction="#handlePreviousMonth" styleClass="nav-button" text="‹">
                     <tooltip><Tooltip text="Previous month (⌘←)" /></tooltip>
                  </Button>
                  <Button onAction="#handleNextMonth" styleClass="nav-button" text="›">
                     <tooltip><Tooltip text="Next month (⌘→)" /></tooltip>
                  </Button>
                  <Label fx:id="monthLabel" styleClass="month-title" />
                  <Button fx:id="thisMonthButton" onAction="#handleThisMonth" styleClass="quiet" text="Back to this month" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#handleSetBudget" text="Set budget" />
                  <Button onAction="#handleManageCategories" text="Categories" />
                  <Button onAction="#handleSettings" styleClass="quiet" text="Settings" />
               </children>
            </HBox>
            <SummaryStrip fx:id="summaryStrip" />
         </children>
      </VBox>
   </top>

   <center>
      <HBox spacing="16.0">
         <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" />
         </padding>
         <children>
            <VBox spacing="10.0" styleClass="panel" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label styleClass="panel-title" text="Expenses" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="addButton" onAction="#handleAddExpense" styleClass="primary" text="+ Add expense">
                           <tooltip><Tooltip text="Add expense (⌘N)" /></tooltip>
                        </Button>
                        <Button fx:id="editButton" onAction="#handleEditExpense" text="Edit">
                           <tooltip><Tooltip text="Edit (Enter, or double-click a row)" /></tooltip>
                        </Button>
                        <Button fx:id="deleteButton" onAction="#handleDeleteExpense" text="Delete">
                           <tooltip><Tooltip text="Delete (⌫)" /></tooltip>
                        </Button>
                        <Button onAction="#handleExportToCSV" styleClass="quiet" text="Export CSV" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <TextField fx:id="searchField" promptText="Search description, category or amount (⌘F)" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="categoryFilter" prefWidth="180.0" />
                     </children>
                  </HBox>
                  <TableView fx:id="expenseTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="descriptionColumn" prefWidth="300.0" text="Description" />
                        <TableColumn fx:id="categoryColumn" prefWidth="140.0" text="Category" />
                        <TableColumn fx:id="amountColumn" prefWidth="140.0" styleClass="amount-column" text="Amount" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                     </columnResizePolicy>
                  </TableView>
                  <Label fx:id="resultLabel" styleClass="result-line" />
               </children>
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="340.0" prefWidth="380.0" maxWidth="420.0" style="-fx-background-color: transparent; -fx-background: transparent;">
               <content>
                  <VBox spacing="16.0">
                     <children>
                        <VBox styleClass="panel">
                           <children>
                              <PieChart fx:id="chart" labelsVisible="false" legendSide="BOTTOM" minHeight="300.0" prefHeight="320.0" />
                           </children>
                        </VBox>
                        <VBox spacing="12.0" styleClass="panel">
                           <children>
                              <Label fx:id="budgetTitle" styleClass="panel-title" text="Budgets" />
                              <BudgetPanel fx:id="budgetPanel" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </HBox>
   </center>
</BorderPane>
